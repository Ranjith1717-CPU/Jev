# Copy this file to .env and fill in your real key. Never commit .env.
# Get a key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Optional: compare Jev against Claude Haiku 4.5 on /mail, /send and /paste.
# Create a key at https://platform.claude.com (API usage is billed separately
# from Claude Team/Pro plans; Haiku 4.5 is $1 / $5 per million tokens).
ANTHROPIC_API_KEY=

# Optional: override the port the server listens on.
PORT=3000

# Optional — only needed for the "My Gmail" toggle on /mail.
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console, enable the Gmail API, and add the redirect URI below to it.
# See README.md for the full step-by-step.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
